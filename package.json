{
  "name": "mochikao",
  "version": "0.1.0",
  "description": "Deterministic avatars: any string becomes a cute, unique SVG character. Zero dependencies, React / Vue / Svelte / Solid / web component.",
  "keywords": [
    "avatar",
    "identicon",
    "generative",
    "svg",
    "deterministic",
    "blob",
    "kawaii",
    "react",
    "vue",
    "svelte",
    "solid",
    "web-component"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexvolkihar/mochikao.git"
  },
  "homepage": "https://github.com/Alexvolkihar/mochikao#readme",
  "bugs": {
    "url": "https://github.com/Alexvolkihar/mochikao/issues"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "mochikao-source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./element": {
      "mochikao-source": "./src/element.ts",
      "types": "./dist/src/element.d.ts",
      "default": "./dist/src/element.js"
    },
    "./react": {
      "mochikao-source": "./src/react.ts",
      "types": "./dist/src/react.d.ts",
      "default": "./dist/src/react.js"
    },
    "./vue": {
      "mochikao-source": "./src/vue.ts",
      "types": "./dist/src/vue.d.ts",
      "default": "./dist/src/vue.js"
    },
    "./solid": {
      "mochikao-source": "./src/solid.ts",
      "types": "./dist/src/solid.d.ts",
      "default": "./dist/src/solid.js"
    },
    "./morph": {
      "mochikao-source": "./src/morph.ts",
      "types": "./dist/src/morph.d.ts",
      "default": "./dist/src/morph.js"
    },
    "./params": {
      "mochikao-source": "./src/params.ts",
      "types": "./dist/src/params.d.ts",
      "default": "./dist/src/params.js"
    },
    "./animals": {
      "mochikao-source": "./src/families/animals.ts",
      "types": "./dist/src/families/animals.d.ts",
      "default": "./dist/src/families/animals.js"
    },
    "./produce": {
      "mochikao-source": "./src/families/produce.ts",
      "types": "./dist/src/families/produce.d.ts",
      "default": "./dist/src/families/produce.js"
    },
    "./svelte": {
      "types": "./src/svelte/Mochikao.svelte.d.ts",
      "svelte": "./src/svelte/Mochikao.svelte",
      "default": "./src/svelte/Mochikao.svelte"
    }
  },
  "bin": {
    "mochikao": "dist/bin/mochikao.js"
  },
  "files": [
    "dist/src",
    "dist/bin",
    "src/svelte"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json",
    "build:site": "vite build",
    "api": "node api/server.ts",
    "test": "node --conditions=mochikao-source --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=18",
    "solid-js": ">=1.8",
    "svelte": ">=5",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "solid-js": "^1.9.15",
    "svelte": "^5.57.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue": "^3.5.43"
  }
}
